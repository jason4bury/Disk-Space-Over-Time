# Disk Space Over Time settings. Copy this file to .env next to docker-compose.yml and fill in
# the values. .env holds a real password: it is gitignored, so never commit it.
# Which drives to check is picked in Settings on the page (drives of this machine also need a
# line in docker-compose.yml).

# Sign-in (required). The app will not start until these are changed from the examples.
APP_USERNAME=your-username
APP_PASSWORD=change-me

# Long random string used to sign the sign-in cookie and encrypt the saved SSH key (at least 32
# characters). If you change it later, add the SSH key again in Settings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Your time zone, so the day's reading is made at your RECORD_TIME, such as Europe/London or
# America/New_York (the list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=Etc/UTC

# The time of day every drive is read (24-hour clock). If the machine is off then, the day's
# reading is made as soon as it's back.
RECORD_TIME=03:00

# How many days of readings to keep (0 = keep them all; a year of daily readings for ten
# drives is well under 1 MB).
KEEP_DAYS=0

# Optional. The rate a drive is filling is worked out over this many days (at least 14).
TREND_DAYS=90
# Optional. A drive is "Low on space" under this % free, and "Filling up" when it will be full
# within SOON_DAYS days.
LOW_PERCENT=10
SOON_DAYS=90

# Optional: only trust machines whose SSH host key has one of these fingerprints (comma-separated),
# as shown by   ssh-keyscan -p 22 192.168.1.20 | ssh-keygen -lf -
# Blank accepts whatever host key the machine shows.
SSH_FINGERPRINTS=

# Optional: the drives to check, until you pick them in Settings. Comma-separated
# Name=folder or Name=ssh://user@address:port/mount, such as
#   DRIVES=C=/drives/C, NAS=ssh://admin@192.168.1.20:22/volume1
# Blank starts with every drive mounted under /drives in docker-compose.yml (none, if you only
# read drives over SSH). Settings can add or remove drives at any time.
DRIVES=

# --- Running without Docker (npm start) ---
# Readings and settings are kept in ./data unless DATA_DIR is set, and it listens on port 3060
# unless PORT is set. Settings lists the folders inside DRIVES_ROOT (such as DRIVES_ROOT=C:/Drives),
# or set DRIVES, such as DRIVES=C=C:/, D=D:/
